#!/usr/bin/env bash
# Android 快速运行（源文件不入库，模板见本文件；复制为 run-android.sh 后改设备 id 与后端地址）。
# 用 adb pair / adb connect 连无线设备时，-d 用 "ip:port"，不是序列号。
set -e
DEVICE_ID=<设备 id 或 ip:port>            # flutter devices 查看
API_BASE_URL=http://<后端局域网 IP:端口>  # 直连模式不需要后端，整行可删
cd "$(dirname "$0")/frontend"
flutter run -d "$DEVICE_ID" --dart-define=API_BASE_URL="$API_BASE_URL" --dart-define=BUILD_STAMP="$(date +%F_%T)" "$@"