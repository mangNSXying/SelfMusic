# 打 Windows 桌面 release 包（x64）。
# 产物：frontend\build\dist\SelfMusic_<版本>_windows_x64_release.zip
# 解压后直接运行 selfmusic.exe；目标机若没装 VC++ 2015-2022 x64 运行库可能起不来。
# 构建机：Win10 + Flutter stable + VS2022 Build Tools（"使用 C++ 的桌面开发"负载 + ATL）。
# 源文件不入库，模板见本文件；复制为 build-windows.ps1 后改下面的工具链/分发路径。
# 执行策略拦下的话：powershell -ExecutionPolicy Bypass -File .\build-windows.ps1
# 用法：.\build-windows.ps1 [额外 flutter build 参数]
param(
    [Parameter(ValueFromRemainingArguments = $true)]
    [string[]]$FlutterArgs = @()
)

$ErrorActionPreference = 'Stop'

# ---- 本机工具链（换机器改这里）----
$Flutter = 'C:/path/to/flutter/bin/flutter.bat'
# 分发目录：留空 = 只出包到 frontend\build\dist；填了会再拷一份过去。
$DistDir = ''

if (-not (Test-Path $Flutter)) {
    Write-Host "[缺工具链] 找不到 $Flutter，先改脚本顶部的 `$Flutter"
    exit 1
}

# permission_handler_windows 用 find_program 在 PATH 里找 nuget.exe（拉 CppWinRT 头）；
# 找不到就退回 CMake 内置下载器（无超时，弱网下会挂死）。
# 把 nuget.exe 放在 flutter.bat 同目录，脚本会把这个目录前置到 PATH。
# 缓存也重定向到工具链目录，避免落进 C:\Users\...\AppData。
$FlutterDir = Split-Path -Parent $Flutter
$env:PATH = "$FlutterDir;$env:PATH"
$env:NUGET_HTTP_CACHE_PATH = Join-Path $FlutterDir 'NuGetHttpCache'
if (-not (Get-Command nuget.exe -ErrorAction SilentlyContinue)) {
    Write-Host '[提示] PATH 里没有 nuget.exe；首次构建 permission_handler_windows 可能卡在下载 CppWinRT 头。'
}

$Frontend = Join-Path $PSScriptRoot 'frontend'
Push-Location $Frontend
try {
    $Stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
    $Arch = 'x64'
    $Mode = 'release'

    # 版本号取 pubspec.yaml 的 version 主段（去掉 +build）。
    $Pubspec = Get-Content (Join-Path $Frontend 'pubspec.yaml') -Raw
    $VersionMatch = [regex]::Match($Pubspec, '(?m)^version:\s*([^\s#]+)')
    $Version = if ($VersionMatch.Success) {
        $VersionMatch.Groups[1].Value.Split('+')[0]
    }
    else {
        '0.0.0'
    }

    & $Flutter pub get
    if ($LASTEXITCODE -ne 0) {
        throw "flutter pub get 失败（exit $LASTEXITCODE）"
    }

    # 构建前清空 Release 目录：Flutter 的 INSTALL 只覆盖/新增文件，不会删除旧产物。
    # 不清理时，历史 debug 构建残留的 kernel_blob.bin（约 90MB）、isolate/vm_snapshot_*
    # 会被原样打进 zip，实测多出 100MB+。
    $ReleaseDir = Join-Path $Frontend 'build\windows\x64\runner\Release'
    if (Test-Path $ReleaseDir) {
        try {
            Remove-Item $ReleaseDir -Recurse -Force
        }
        catch {
            throw "清不掉旧的 Release 目录（可能 selfmusic.exe 正在运行）：$ReleaseDir。关掉程序后重试。"
        }
    }

    & $Flutter build windows --release "--dart-define=BUILD_STAMP=$Stamp" @FlutterArgs
    if ($LASTEXITCODE -ne 0) {
        throw "flutter build windows 失败（exit $LASTEXITCODE）"
    }

    $Exe = Join-Path $ReleaseDir 'selfmusic.exe'
    if (-not (Test-Path $Exe)) {
        throw "构建产物缺失：$Exe"
    }

    # 兜底：release bundle 用 AOT（app.so），不需要任何 JIT 快照；个别 Flutter 版本
    # 或手工把 debug 产物拷回来时仍可能残留，打包前再剔除一次。
    $JitFiles = @(
        'kernel_blob.bin',
        'isolate_snapshot_data',
        'isolate_snapshot_instr',
        'vm_snapshot_data',
        'vm_snapshot_instr',
        '.last_build_id'
    ) |
        ForEach-Object { Join-Path $ReleaseDir "data\flutter_assets\$_" } |
        Where-Object { Test-Path $_ }
    if ($JitFiles) {
        $JitFiles | Remove-Item -Force
        Write-Host "已剔除调试/JIT 残留：$(@($JitFiles).Count) 个文件"
    }

    $OutDir = Join-Path $Frontend 'build\dist'
    New-Item -ItemType Directory -Path $OutDir -Force | Out-Null
    $Zip = Join-Path $OutDir "SelfMusic_${Version}_windows_${Arch}_${Mode}.zip"
    Compress-Archive -Path (Join-Path $ReleaseDir '*') -DestinationPath $Zip -Force

    $Hash = (Get-FileHash $Zip -Algorithm SHA256).Hash.ToLower()
    Write-Host "出包完成：$Zip"
    Write-Host "SHA256：$Hash"

    if ($DistDir) {
        if (-not (Test-Path $DistDir)) {
            throw "分发目录不存在：$DistDir"
        }
        Copy-Item $Zip $DistDir -Force
        Write-Host "已拷贝到：$DistDir"
    }
}
finally {
    Pop-Location
}
