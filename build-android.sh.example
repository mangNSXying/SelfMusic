#!/usr/bin/env bash
# 打轻量级 Android 安装包（release + 按 ABI 拆分）。
# 产物：frontend/build/dist/SelfMusic_<版本>_android_<架构>_release.apk
# 架构：arm64（arm64-v8a）/ armv7（armeabi-v7a）/ x64（x86_64）
# 真机（arm64）装 SelfMusic_<版本>_android_arm64_release.apk，约 22MB。
# 注意：flutter run / app-debug.apk 是 debug 包，含 JIT 快照与全部 ABI，约 200MB，勿用于分发。
# 源文件不入库，模板见本文件；复制为 build-android.sh 后按需改产物拷贝段。
set -euo pipefail
cd "$(dirname "$0")/frontend"

# 版本号取 pubspec.yaml 的 version 主段（去掉 +build）。
VERSION="$(sed -n 's/^version:[[:space:]]*//p' pubspec.yaml)"
VERSION="${VERSION%%+*}"
VERSION=${VERSION:-0.0.0}
MODE=release

flutter build apk --release --split-per-abi --dart-define=BUILD_STAMP="$(date +%F_%T)" "$@"

DIST_DIR="${DIST_DIR:-build/dist}"
mkdir -p "$DIST_DIR"
for APK in build/app/outputs/flutter-apk/app-*-release.apk; do
    ABI="$(basename "$APK" | sed -E 's/^app-(.+)-release\.apk$/\1/')"
    case "$ABI" in
        arm64-v8a) ARCH=arm64 ;;
        armeabi-v7a) ARCH=armv7 ;;
        x86_64) ARCH=x64 ;;
        *) ARCH="$ABI" ;;
    esac
    cp "$APK" "$DIST_DIR/SelfMusic_${VERSION}_android_${ARCH}_${MODE}.apk"
done
ls -lh "$DIST_DIR"/SelfMusic_"${VERSION}"_android_*_"${MODE}".apk

# 拷贝到自建分发位置（按本机实际路径改；不需要就整段删掉）：
# cp "$DIST_DIR/SelfMusic_${VERSION}_android_arm64_${MODE}.apk" <分发目录>/