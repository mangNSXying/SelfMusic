# 鸿蒙出包脚本（模板，入库；本机副本不入库）
# 复制为 build-ohos.ps1 后改下面的工具链路径：
#   Copy-Item build-ohos.ps1.example build-ohos.ps1
#   notepad build-ohos.ps1
# 用法：
#   .\build-ohos.ps1          AGC 发布签名 .app（arm64；出包前临时切发布签名，结束无条件还原 debug 签名）
#   .\build-ohos.ps1 hap      release 双架构 HAP（arm64/x64，日常分发/直装转正用）
# 执行策略拦下的话：powershell -ExecutionPolicy Bypass -File .\build-ohos.ps1 [hap]
param(
    [string]$Target
)

$ErrorActionPreference = 'Stop'
Set-Location -Path (Join-Path $PSScriptRoot 'frontend')

# 本机工具链路径（换机器改这里）
# FLUTTER 指向 ohos 分支的 flutter.bat（stable 与 Harmony fork 两套 SDK 可并存，
# 用独立 wrapper 目录分开，见 run-windows.bat.example 里的 FLUTTER_BIN 说明）。
$Flutter = 'C:/path/to/flutter-ohos/bin/flutter.bat'
$DevEco = 'C:/path/to/DevEco Studio'
$env:DEVECO_SDK_HOME = Join-Path $DevEco 'sdk'
$env:PATH = (@(
        (Join-Path $DevEco 'jbr\bin'),
        (Join-Path $DevEco 'tools\hvigor\bin'),
        (Join-Path $DevEco 'tools\ohpm\bin'),
        (Join-Path $DevEco 'tools\node')
    ) + $env:PATH) -join ';'

if (-not $Target) { $Target = 'app' }
if ($Target -ne 'app' -and $Target -ne 'hap') {
    Write-Host '用法：.\build-ohos.ps1 [hap]   缺省出 AGC 发布签名 .app'
    exit 1
}

# ---- hap：release 双架构，签名材料原样不动 ----
# 不含 ohos-arm（32 位）：本 fork 的引擎只发布 ohos-arm64 / ohos-x64 的 HAR，
# ohos-arm-release\armeabi_v7a_release.har 缺失会让 ohpm install 直接失败。
if ($Target -eq 'hap') {
    & $Flutter build hap --release --target-platform ohos-arm64 --target-platform ohos-x64
    exit $LASTEXITCODE
}

# ---- app：临时切发布签名 - 出包 - 无条件还原 ----
# release.cer / release.p7b 放 %USERPROFILE%\.ohos\config\，由 AGC 签发。
# 脚本只换 build-profile.json5 里的 certpath/profile 两个字段，storeFile、keyAlias、
# 密码保持 debug 侧原值；出包结束（含失败）无条件还原原文件。
# 注意：不能按 default_ohos_* 文件名匹配——DevEco 自动签名写的可能是
# debug-shared.cer / debug.p7b，按文件名替换会静默失效，最终拿 debug Profile 出包。
$ConfigDir = Join-Path $env:USERPROFILE '.ohos\config'
$ReleaseCer = Join-Path $ConfigDir 'release.cer'
$ReleaseProfile = Join-Path $ConfigDir 'release.p7b'
$Missing = @($ReleaseCer, $ReleaseProfile) | Where-Object { -not (Test-Path $_) }
if ($Missing) {
    $Missing | ForEach-Object { Write-Host "[缺发布材料] $_ 不存在" }
    Write-Host '先在 AGC 签发发布证书/发布 Profile，命名为 release.cer / release.p7b 放入上述目录'
    exit 1
}

# AGC 7014：包内权限必须是 Profile 申请权限的子集。
# FILE_ACCESS_PERSIST 是 ACL 权限，module.json5 里有还不够，release.p7b 的
# acls.allowed-acls 里也必须有；缺了会在上传时报「Profile文件内不存在」。
$ModuleJson = Get-Content (Join-Path (Get-Location) 'ohos\entry\src\main\module.json5') -Raw
$ProfileText = [System.Text.Encoding]::UTF8.GetString([System.IO.File]::ReadAllBytes($ReleaseProfile))
if ($ModuleJson -match 'ohos\.permission\.FILE_ACCESS_PERSIST' -and
    $ProfileText -notmatch 'ohos\.permission\.FILE_ACCESS_PERSIST') {
    Write-Host '[警告] release.p7b 的 ACL 权限未包含 ohos.permission.FILE_ACCESS_PERSIST'
    Write-Host '       AGC 上传会报 7014（Profile 文件内不存在）。'
    Write-Host '       请到 AGC 编辑/新建发布 Profile，在 ACL（受限）权限中勾选该权限，'
    Write-Host '       重新下载 release.p7b 覆盖后重跑本脚本。'
}

$Profile = Join-Path (Get-Location) 'ohos\build-profile.json5'
$Backup = Join-Path $env:TEMP 'build-profile.json5.bak'
Copy-Item -Path $Profile -Destination $Backup -Force

try {
    $Text = [System.IO.File]::ReadAllText($Profile)
    $CerPath = $ReleaseCer -replace '\\', '/'
    $ProfilePath = $ReleaseProfile -replace '\\', '/'
    $NewText = $Text -replace "(?m)^(\s*certpath\s*:\s*)'[^']*'", "`$1'$CerPath'" `
        -replace "(?m)^(\s*profile\s*:\s*)'[^']*'", "`$1'$ProfilePath'"
    if ($NewText -notmatch [regex]::Escape($CerPath) -or
        $NewText -notmatch [regex]::Escape($ProfilePath)) {
        throw 'build-profile.json5 里没找到 certpath/profile 字段，无法切换发布签名'
    }
    [System.IO.File]::WriteAllText($Profile, $NewText, (New-Object System.Text.UTF8Encoding($false)))
    & $Flutter build app --release --target-platform ohos-arm64
    $ExitCode = $LASTEXITCODE
}
finally {
    Copy-Item -Path $Backup -Destination $Profile -Force
}

if ($ExitCode -eq 0) {
    Write-Host '出包完成：frontend\build\ohos\app\ohos-default-signed.app'
}
exit $ExitCode
