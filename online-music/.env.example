# Sidecar 监听地址/端口（容器内一般不用改）
ONLINE_MUSIC_HOST=0.0.0.0
ONLINE_MUSIC_PORT=18090

# 必填：客户端与 sidecar 的共享 token。留空则自动生成并写入
# $ONLINE_MUSIC_STATE_DIR/token（首次启动日志会打印路径）。
ONLINE_MUSIC_TOKEN=change-me

# 暴露给客户端的音乐源（逗号分隔）
ONLINE_MUSIC_SOURCES=QQMusicClient,KuwoMusicClient,MiguMusicClient

# 状态/临时文件目录；Docker 中映射挂载卷
ONLINE_MUSIC_STATE_DIR=./state

# 搜索单源超时、token/任务清理时间、并发下载数
ONLINE_MUSIC_SEARCH_TIMEOUT_SEC=30
ONLINE_MUSIC_TOKEN_TTL_MIN=30
ONLINE_MUSIC_JOB_TTL_MIN=30
ONLINE_MUSIC_MAX_FETCHES=2
ONLINE_MUSIC_MAX_RESULTS_PER_SOURCE=10
